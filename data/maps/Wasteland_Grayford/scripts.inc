Wasteland_Grayford_MapScripts::
	.byte 0

Wasteland_Grayford_EventScript_Senna::
	lock
	faceplayer
	msgbox Wasteland_Grayford_Text_SennaHoundourExplanation, MSGBOX_DEFAULT
	release
	end

Wasteland_Grayford_Text_SennaHoundourExplanation::
	.string "SENNA: You've got a late one there.\p"
	.string "I've seen dogs like yours pass through\n"
	.string "Grayford before - the quiet kind, the\l"
	.string "kind that takes its time. Some folks\n"
	.string "panic and sell them off cheap. Mistake,\l"
	.string "every time.\p"
	.string "It's not sickness, and it's not\n"
	.string "slow-witted either. I watched three of\l"
	.string "them grow up right here in town, years\n"
	.string "back. Nothing to see, nothing to see…\l"
	.string "and then one day they weren't pups\n"
	.string "anymore.\p"
	.string "I'm not reading anything off it, before\n"
	.string "you ask. I just watch. Same as anyone\l"
	.string "with eyes and enough years behind them.\p"
	.string "Feed it right, walk it hard, and don't\n"
	.string "rush it. It'll tell you when it's\l"
	.string "ready.$"
